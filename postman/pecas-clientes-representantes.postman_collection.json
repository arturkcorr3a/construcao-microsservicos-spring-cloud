{
  "info": {
    "name": "Peças, Clientes e Representantes (via Gateway)",
    "description": "Testa os três microsserviços acessando somente o API Gateway (baseUrl = http://localhost:8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Peças",
      "item": [
        {
          "name": "Cadastrar peça 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pecas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pecas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{pecaId1}},\n  \"nome\": \"Parafuso {{tagPeca}}\",\n  \"descricao\": \"Parafuso sextavado M8\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera ids/nomes unicos para a coleção poder rodar várias vezes sem reiniciar os serviços",
                  "const base = Math.floor(Math.random() * 1e9) + 1000;",
                  "pm.collectionVariables.set(\"pecaId1\", base);",
                  "pm.collectionVariables.set(\"pecaId2\", base + 1);",
                  "pm.collectionVariables.set(\"tagPeca\", Math.random().toString(36).slice(2, 8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Retorna a peça cadastrada\", () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.id).to.eql(Number(pm.collectionVariables.get(\"pecaId1\")));",
                  "    pm.expect(b.nome).to.eql(\"Parafuso \" + pm.collectionVariables.get(\"tagPeca\"));",
                  "    pm.expect(b.descricao).to.eql(\"Parafuso sextavado M8\");",
                  "});"
                ]
              }
            }
          ]
        },
